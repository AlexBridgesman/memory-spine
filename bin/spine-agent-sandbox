#!/bin/bash
# spine-agent-sandbox — an isolated configuration home for an agent app.
#
# Connecting a model inside another app can inherit a broader agent profile
# (projects, plugins, MCP connectors, and memories). This helper breaks that
# configuration inheritance. It is not an OS security boundary and does not
# block direct filesystem reads or writes allowed by the current user account.
#
# Usage:
#   spine-agent-sandbox <app-name>      # create the home + show how to launch
#   spine-agent-sandbox --list          # existing sandboxes
set -u
ROOT="$HOME/agent-sandboxes"

if [ "${1:-}" = "--list" ]; then
  echo "=== AGENT SANDBOXES ($ROOT)"
  [ -d "$ROOT" ] || { echo "  (none)"; exit 0; }
  for d in "$ROOT"/*/; do
    [ -d "$d" ] || continue
    n=$(basename "$d")
    echo "  * $n   created $(date -r "$d" '+%F')"
  done
  exit 0
fi

NAME="${1:-}"
[ -n "$NAME" ] || { echo "usage: spine-agent-sandbox <app-name> | --list" >&2; exit 1; }
case "$NAME" in
  *[!a-zA-Z0-9._-]*) echo "spine-agent-sandbox: name may contain only a-z 0-9 . _ -" >&2; exit 1;;
esac

BOX="$ROOT/$NAME"
CX="$BOX/codex-home"
CC="$BOX/claude-home"
mkdir -p "$CX" "$CC" || exit 1

# --- Codex: a minimal config. The key part — NO memory vault in writable_roots,
# no mcp_servers, no plugins; only the app's own working folder.
if [ ! -f "$CX/config.toml" ]; then
cat > "$CX/config.toml" << EOF
# Isolated Codex profile for "${NAME}" (spine-agent-sandbox, $(date +%F)).
# Do NOT add the memory vault, connectors or plugins here — the whole point of
# this home is that a third-party app does NOT inherit the owner's working
# environment.
[features]
memories = false

[sandbox_workspace_write]
writable_roots = ["$BOX/workspace"]
EOF
fi
mkdir -p "$BOX/workspace"

# --- Claude Code: an empty profile with no configured MCP servers.
[ -f "$CC/.claude.json" ] || echo '{}' > "$CC/.claude.json"

cat > "$BOX/LAUNCH.md" << EOF
# Agent sandbox "${NAME}"

Launch the app ONLY with these variables — otherwise it will again see the
owner's working profile (projects, plugins, connectors, memory):

    CODEX_HOME="$CX" CLAUDE_CONFIG_DIR="$CC" open -a "$NAME"

or in a terminal before launching a CLI:

    export CODEX_HOME="$CX"
    export CLAUDE_CONFIG_DIR="$CC"

What is inside:
- codex-home/config.toml — no MCP, no plugins, memories=false,
  with $BOX/workspace as the configured writable root
- claude-home/ — an empty profile, 0 MCP servers
- workspace/ — the intended working folder

Security boundary:
- Spine command access is denied by the default-deny gate.
- This helper does not block direct filesystem reads or writes. The app and
  child processes retain whatever filesystem access the OS user permits.
If this app genuinely needs Spine command access, the owner decides explicitly:
    spine-approve "<path fragment of the app>" "$NAME"
EOF

echo "Sandbox ready: $BOX"
echo
echo "Launch the app like this:"
echo "  CODEX_HOME=\"$CX\" CLAUDE_CONFIG_DIR=\"$CC\" open -a \"$NAME\""
echo
echo "Spine command access is DENIED (default-deny gate)."
echo "Direct filesystem access is NOT blocked by this helper."
echo "Grant Spine command access deliberately: spine-approve \"<path fragment>\" \"$NAME\""
echo "Details: $BOX/LAUNCH.md"
