#!/usr/bin/env python3
"""spine-recall — search across Memory Spine memory (v3.3, 2026-07-04).

The primary read tool for agents and the owner: searches title + summary +
keywords + tags + body of ALL records (rg remains available for raw grep).

Usage:
  spine-recall "multi word query"                # AND across terms, case-insensitive
  spine-recall "ci runner" --scope ai-infra      # a single project only
  spine-recall --scope work --since 2026-06-15   # no query = recent records of a scope
  spine-recall "deploy" --type decision --confidence verified
  spine-recall "..." --all                       # include archived/superseded
  spine-recall "..." --limit 50

Read-only. Output: cards in descending creation-date order.
"""
import argparse
import datetime
import os
import re
import shlex
import sys

ROOT = os.path.abspath(os.path.expanduser(os.environ.get("SPINE_ROOT", "~/AgentMemory")))
TOOLS = os.environ.get("SPINE_TOOLS_DIR") or os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(TOOLS, "lib"))
from spine_paths import default_log_root
def _config_dir():
    """Same resolution order as spine-gen (keep in sync)."""
    env = os.environ.get("SPINE_CONFIG_DIR")
    if env:
        return os.path.expanduser(env)
    tools = TOOLS
    vault = ROOT
    for c in (os.path.join(tools, "config"), os.path.join(vault, "config")):
        if os.path.isfile(os.path.join(c, "projects.txt")):
            return c
    return os.path.join(tools, "config")


CFG = _config_dir()
TYPEDIRS = {"decisions": "decision", "facts": "fact", "threads": "thread", "artifacts": "artifact"}


def load_projects():
    path = os.path.join(CFG, "projects.txt")
    try:
        with open(path) as f:
            return [l.strip() for l in f if l.strip() and not l.lstrip().startswith("#")]
    except OSError:
        sys.exit(f"spine-recall: dictionary missing: {path}")


def parse_record(path):
    try:
        text = open(path, encoding="utf-8", errors="replace").read()
    except OSError:
        return None
    if not text.startswith("---\n"):
        return None
    end = text.find("\n---", 4)
    if end < 0:
        return None
    fm, key = {}, None
    for line in text[4:end].splitlines():
        m = re.match(r"^([A-Za-z_]+):\s*(.*)$", line)
        if m:
            key = m.group(1)
            v = m.group(2).strip().strip('"')
            fm[key] = v if v else []
        elif re.match(r"^\s+-\s+", line) and isinstance(fm.get(key), list):
            fm[key].append(line.strip()[2:].strip())
    fm["_path"] = path
    fm["_body"] = text[end + 4:]
    return fm


def rec_date(r):
    v = r.get("created") or ""
    m = re.match(r"(\d{4}-\d{2}-\d{2})", v if isinstance(v, str) else "")
    return m.group(1) if m else "0000-00-00"


def searchable(r):
    parts = [r.get("title", ""), r.get("summary", ""), r["_body"],
             os.path.basename(r["_path"])]
    for k in ("keywords", "tags", "aliases"):
        v = r.get(k)
        if isinstance(v, list):
            parts += v
        elif isinstance(v, str):
            parts.append(v)
    return "\n".join(p for p in parts if isinstance(p, str)).casefold()


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("query", nargs="?", default="")
    ap.add_argument("--scope", choices=load_projects())
    ap.add_argument("--type", choices=sorted(TYPEDIRS.values()))
    ap.add_argument("--since", help="YYYY-MM-DD or YYYY-MM")
    ap.add_argument("--confidence", choices=["candidate", "reported", "verified", "legacy", "untrusted"])
    ap.add_argument("--all", action="store_true", help="include archived/superseded/resolved")
    ap.add_argument("--limit", type=int, default=20)
    a = ap.parse_args()
    if a.limit < 1:
        ap.error("--limit must be >= 1")

    if not a.query and not a.scope and not a.since:
        ap.error("provide a query, or at least --scope / --since")

    # ACCESS GATE (third-party desktop agent incident, 2026-07-28):
    # memory search is available only to approved callers. A broken/missing
    # gate is FAIL-CLOSED; SPINE_NO_GATE=1 is the explicit opt-out for
    # deliberately gateless installs (one stderr warning, then proceed).
    gate_lib = os.path.join(TOOLS, "lib")
    sys.path.insert(0, gate_lib)
    try:
        import spine_gate
    except ImportError:
        if os.environ.get("SPINE_NO_GATE") == "1":
            sys.stderr.write("spine-recall: WARNING: running without the access gate (SPINE_NO_GATE=1)\n")
        else:
            sys.stderr.write(
                f"spine-recall: ERROR: access gate not importable from {gate_lib} — refusing (fail-closed).\n"
                "  Restore lib/spine_gate.py (or point SPINE_TOOLS_DIR at the tools repo),\n"
                "  or set SPINE_NO_GATE=1 for a deliberately gateless install.\n")
            sys.exit(1)
    else:
        if not spine_gate.enforce("recall", a.scope):
            sys.exit(2)

    since = None
    if a.since:
        if not re.fullmatch(r"\d{4}-(0[1-9]|1[0-2])(-\d{2})?", a.since):
            ap.error("--since: format YYYY-MM-DD or YYYY-MM (month 01-12)")
        since = a.since if len(a.since) == 10 else a.since + "-01"

    # synonyms (v3.4): each term expands into a nest of variants;
    # a match = at least one variant of EVERY term
    syn_groups = []
    syn_path = os.path.join(CFG, "synonyms.tsv")
    if os.path.exists(syn_path):
        for line_no, raw in enumerate(open(syn_path, encoding="utf-8"), 1):
            line = raw.strip()
            if not line or line.startswith("#"):
                continue
            term, sep, equivalents = line.partition("\t")
            words = [term.strip(), *(w.strip() for w in equivalents.split(","))]
            words = [w.casefold() for w in words if w]
            if not sep or len(words) < 2:
                sys.stderr.write(
                    f"spine-recall: malformed synonyms.tsv row {line_no}; "
                    "expected term<TAB>comma,separated,equivalents\n")
                continue
            syn_groups.append(set(words))

    def variants(term):
        v = {term}
        for g in syn_groups:
            if term in g:
                v |= g
        return v

    # MORPHOLOGY (2026-07-28): an inflected query term is not a substring of the
    # base form stored in records ("deploying" vs "deploy") — natural-language
    # questions scored 0/5 on exactly this. Light suffix stemming + stop words.
    # The stem is used ONLY as an additional variant of the term (exact match
    # stays primary), so keyword queries do not degrade.
    # The built-in lists are English. A multilingual vault EXTENDS them via
    # config/recall-lang.conf (external review 2026-07-30: hardcoded English
    # lists made non-English memories second-class): its stopwords/suffixes are
    # ADDED to the built-ins, so mixed-language queries stem in every language
    # you configure. Suffixes are matched longest-first.
    STOP = set("""why how where when what which who whom whose whether
                  the a an to of in on at for with from by about into over under
                  and or but if then than that this these those there here
                  it its is are was were be been being do does did done
                  can could should would will may might must shall
                  have has had my your our their his her me you we they i
                  not no yes need needed want wanted something someone
                  please help know tell show find""".split())
    SUFFIXES = ["ations", "ation", "ments", "ingly", "ment", "ings", "ions",
                "ies", "ing", "ion", "ers", "est", "ed", "es", "ly", "er", "s"]
    lang_conf = os.path.join(CFG, "recall-lang.conf")
    if os.path.exists(lang_conf):
        try:
            for raw in open(lang_conf, encoding="utf-8"):
                raw = raw.strip()
                if not raw or raw.startswith("#") or "=" not in raw:
                    continue
                key, _, val = raw.partition("=")
                if key.strip() == "stopwords":
                    STOP |= {w.casefold() for w in val.split()}
                elif key.strip() == "suffixes":
                    SUFFIXES += [s.casefold() for s in val.split() if s.strip()]
        except OSError as e:
            sys.stderr.write(f"spine-recall: recall-lang.conf unreadable: {e}\n")
    SUFFIXES = tuple(sorted(set(SUFFIXES), key=len, reverse=True))

    def stem(w):
        w = w.casefold()
        for suf in SUFFIXES:
            if len(w) > 5 and w.endswith(suf):
                return w[:-len(suf)]
        return w

    raw_terms = [t for t in a.query.split()
                 if t.strip() and t.casefold() not in STOP and len(t) > 2]
    if not raw_terms:                      # a query made only of stop words — do not lose it
        raw_terms = [t for t in a.query.split() if t.strip()]

    def variants_m(term):
        v = variants(term)
        s = stem(term)
        if s != term and len(s) >= 4:
            v.add(s)                       # "deploying" -> also search for "deploy"
        return v

    terms = [variants_m(t.casefold()) for t in raw_terms]
    scopes = [a.scope] if a.scope else load_projects()

    def head_searchable(r):
        # "head" fields for ranking: short curated ones (title/keywords/filename).
        # No body AND no summary — long summaries polluted the score exactly like
        # body did (benchmark checkpoint #2: verbose infrastructure facts
        # outranked the entity hub the query was actually about)
        parts = [r.get("title", ""), os.path.basename(r["_path"])]
        for k in ("keywords", "tags", "aliases"):
            v = r.get(k)
            if isinstance(v, list):
                parts += v
            elif isinstance(v, str):
                parts.append(v)
        return "\n".join(p for p in parts if isinstance(p, str)).casefold()

    def _hit(v, hay):
        # short variants (<=3 chars, e.g. "tg") match on word boundaries only:
        # plain substring matching would hit "postgres" via the synonym "tg"
        # (code-review fix)
        if len(v) <= 3:
            return re.search(r"(?<!\w)" + re.escape(v) + r"(?!\w)", hay) is not None
        return v in hay

    def match(r, tgroups):
        """None = no match; otherwise score = how many terms hit the head fields."""
        if not tgroups:
            return 0
        hay = searchable(r)
        if not all(any(_hit(v, hay) for v in grp) for grp in tgroups):
            return None
        head = head_searchable(r)
        return sum(1 for grp in tgroups if any(_hit(v, head) for v in grp))

    def scan(tgroups):
        hits = []
        # entities/ — cross-project hubs: always searched (v3.3 review)
        ed = os.path.join(ROOT, "entities")
        if os.path.isdir(ed) and not a.type and not a.confidence:
            for f in os.listdir(ed):
                if not f.endswith(".md"):
                    continue
                r = parse_record(os.path.join(ed, f))
                if not r:
                    continue
                if since and rec_date(r) < since:
                    continue
                sc = match(r, tgroups)
                if sc is None:
                    continue
                r["_score"] = sc
                r["_scope"] = "entities"
                r.setdefault("type", "entity")
                hits.append(r)
        # multi-scope (2026-07-22): with --scope X we scan ALL folders, because a
        # record may live in another "home" scope yet list X in its frontmatter `also:`
        scan_dirs = load_projects() if a.scope else scopes
        for scope in scan_dirs:
            for td, tname in TYPEDIRS.items():
                d = os.path.join(ROOT, scope, td)
                if not os.path.isdir(d):
                    continue
                if a.type and tname != a.type:
                    continue
                for f in os.listdir(d):
                    if not f.endswith(".md"):
                        continue
                    r = parse_record(os.path.join(d, f))
                    if not r:
                        continue
                    if a.scope and scope != a.scope:
                        al = r.get("also")
                        if not (isinstance(al, list) and a.scope in al):
                            continue
                    if not a.all and r.get("status") in ("archived", "superseded", "resolved"):
                        continue
                    if a.confidence and r.get("confidence") != a.confidence:
                        continue
                    if since and rec_date(r) < since:
                        continue
                    sc = match(r, tgroups)
                    if sc is None:
                        continue
                    r["_score"] = sc
                    r["_scope"] = scope
                    hits.append(r)
        # score (precision) first, date as tie-break: checkpoint #2 showed that
        # date-only ordering hides precise old hits under fresh body matches
        hits.sort(key=lambda r: (r.get("_score", 0), rec_date(r)), reverse=True)
        return hits

    def scan_or(tgroups, min_terms=1):
        """OR fallback (2026-07-28): no record has ALL the terms, but some have
        most of them. Score = hits (head fields count double). Natural-language
        questions ("why/how/where...") otherwise returned 0 results — measured
        0/5 before, 5/5 in the top-3 after."""
        need = min(min_terms, len(tgroups))
        out = []
        for scope in (load_projects() if a.scope else scopes):
            for td, tname in TYPEDIRS.items():
                d = os.path.join(ROOT, scope, td)
                if not os.path.isdir(d) or (a.type and tname != a.type):
                    continue
                for f in os.listdir(d):
                    if not f.endswith(".md"):
                        continue
                    r = parse_record(os.path.join(d, f))
                    if not r:
                        continue
                    if a.scope and scope != a.scope:
                        al = r.get("also")
                        if not (isinstance(al, list) and a.scope in al):
                            continue
                    if not a.all and r.get("status") in ("archived", "superseded", "resolved"):
                        continue
                    if a.confidence and r.get("confidence") != a.confidence:
                        continue
                    if since and rec_date(r) < since:
                        continue
                    hay, head = searchable(r), head_searchable(r)
                    nb = sum(1 for g in tgroups if any(_hit(v, hay) for v in g))
                    if nb < need:
                        continue
                    nh = sum(1 for g in tgroups if any(_hit(v, head) for v in g))
                    r["_score"] = nb + 2 * nh
                    r["_scope"] = scope
                    out.append(r)
        out.sort(key=lambda r: (r.get("_score", 0), rec_date(r)), reverse=True)
        return out

    hits = scan(terms)
    dropped_term = None
    if not hits and len(terms) >= 2:
        # drop-one (checkpoint #2): a single absent term must not kill the whole
        # AND query. Branch selection is by quality of the top hit, then by
        # count: a bare count would systematically drop the most discriminative
        # term (code-review fix)
        best, best_i, best_key = [], None, (-1, -1)
        for i in range(len(terms)):
            part = scan(terms[:i] + terms[i + 1:])
            key = (part[0].get("_score", 0) if part else -1, len(part))
            if key > best_key:
                best, best_i, best_key = part, i, key
        if best:
            dropped_term = raw_terms[best_i]
            hits = best
    or_mode = False
    if not hits and len(terms) >= 2:
        hits = scan_or(terms)
        or_mode = bool(hits)
    total = len(hits)
    hits = hits[:a.limit]

    # TELEMETRY (2026-07-28): without it, "search keeps missing" stays unprovable —
    # the 2026-07-28 audit found that over 3 weeks not a single miss was measurable.
    try:
        with open(os.path.join(os.environ.get("SPINE_LOG_DIR", str(default_log_root())), "recall.log"),
                  "a", encoding="utf-8") as lf:
            import time as _t
            mode = "or" if or_mode else ("drop-one" if dropped_term else "and")
            top = hits[0].get("_score", 0) if hits else -1
            lf.write(f"{_t.strftime('%F %T')}\t{mode}\t{total}\t{top}\t"
                     f"{a.scope or '-'}\t{a.query[:120]}\n")
    except OSError:
        pass

    if not hits:
        print("nothing found. Try fewer terms, --all, or raw rg:")
        print(f"  rg -in {shlex.quote(a.query or 'query')} {shlex.quote(os.path.join(ROOT, a.scope or ''))}")
        if len(terms) >= 2:
            for i, grp in enumerate(terms):
                if not scan([grp]):
                    # honest about the check's limits: scan inherits the --scope/--type/... filters
                    print(f"  (term '{raw_terms[i]}' does not occur in this search slice)")
        sys.exit(1)
    if dropped_term is not None:
        print(f"no hits for the full query; showing matches WITHOUT the term '{dropped_term}':")
    elif or_mode:
        print("no exact match on all words; showing the closest by meaning:")

    for r in hits:
        ulid = ""
        m = re.search(r"([0-9A-HJKMNP-TV-Z]{26})\.md$", r["_path"])
        if m:
            ulid = m.group(1)
        status = r.get("status", "?")
        flags = f"{r.get('confidence','?')}" + (f", {status}" if status != "active" else "")
        title = r.get("title") if isinstance(r.get("title"), str) else "(untitled)"
        print(f"[{r.get('type','?')}] {rec_date(r)} ({flags}) {r['_scope']} — {title}")
        if r.get("summary"):
            print(f"    {r['summary'][:200]}")
        print(f"    {ulid}  {os.path.relpath(r['_path'], ROOT)}")
    if total > len(hits):
        print(f"\n(showing {len(hits)} of {total}; use --limit {total} for more)")


if __name__ == "__main__":
    main()
