# Push delivery for spine-notify. Copy to notify.conf and fill in.
# Configure Telegram, ntfy, or both — delivery by any one channel counts.
#
# ntfy (https://ntfy.sh or self-hosted): native iOS/Android push, no bot, no
# account. The topic name is not a secret value, but treat it like a phone
# number — anyone who knows it can read your alerts, so use a long random
# topic (or your own server):
#   ntfy_url=https://ntfy.sh/your-long-random-topic
ntfy_url=
#
# Telegram: chat_id is NOT a secret; the bot token IS — never store its value
# in any file.
chat_id=
# Command that prints the bot token to stdout. Examples:
#   token_cmd=security find-generic-password -s memory-spine/TELEGRAM_BOT_TOKEN -w   (macOS Keychain)
#   token_cmd=op read "op://Private/my-bot/credential"                               (1Password CLI)
#   token_cmd=pass show telegram/spine-bot                                           (pass)
token_cmd=
# Optional (macOS): cache the token in the login Keychain under service
# "memory-spine/TELEGRAM_BOT_TOKEN" so routine notifications never invoke the
# secret manager (spine-tg-token warms/refreshes the cache; an HTTP 401
# invalidates it and pulls a fresh token once). 1 = on, empty/0 = off (default).
keychain_cache=
# Optional: command that refreshes a stale token cache (spine-keeper runs it
# before retrying token_cmd after repeated API failures, e.g. token rotation).
refresh_cmd=
# Numeric Telegram user id allowed to command spine-keeper (NOT a secret).
# Empty = the keeper ignores everyone (no TOFU pairing).
allowlist=
#
# Optional: remote dead-letter drain. Another machine of yours that must hold
# NO notification secrets leaves ntfy_url/chat_id/token_cmd empty there; its
# messages stack up in its local dead-letter queue, and THIS machine pulls
# them over ssh every sync cycle and relays them through its own channel,
# marked with the tag. Crash-safe: the remote queue is renamed to .draining
# first and removed only after a successful local append — a failure at the
# worst point costs a duplicate, never a loss.
#   drain_remote_host: ssh destination (a Host alias from ~/.ssh/config whose
#     key works non-interactively: BatchMode, no passphrase)
#   drain_remote_tag:  short label prefixed to relayed messages
#     (default: the host value)
#   drain_remote_queue: queue path on the remote (default:
#     ~/Library/Logs/AgentMemory/notify-deadletter.log)
drain_remote_host=
drain_remote_tag=
drain_remote_queue=
