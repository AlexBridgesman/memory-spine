#!/usr/bin/env python3
"""spine-secrets-lint — "password in prose" heuristic (v3.4, owner decision 2026-07-04).

gitleaks catches tokens by pattern; this check catches human prose:
"password: correcthorse123", "passphrase = hunter2". Locators do NOT trigger
("the password lives in 1Password item X" is a legitimate record per the
contract: name + location, never the value).

Language note (v3.4 review): a vault written in a non-English language bypassed
a Latin-only keyword list. The list below is English; if your vault language
differs, extend KEYWORD with your language's words for password/token/key/
secret/credential, and keep the non-Latin-prose filter below in mind.

Usage: spine-secrets-lint <file.md> [...]   Exit 0 = clean; 1 = suspicion (REJECT in sync).
"""
import re
import sys

# Word boundary in front (hyphenated slugs like "...-secret-..." do not trigger);
# [^\w-] excludes letters of ANY script, so the boundary holds in non-English text too.
KEYWORD = re.compile(
    r"(?:^|[^\w-])"
    r"(?:password|passwd|passphrase|pass[_\s]?phrase|token|"
    r"api[_\s]?key|apikey|secret|credential\w*|private[_\s]?key)"
    r"\s*[:=]\s*(\S{6,})", re.I)
# BARE high-confidence token formats (external review 2026-07-30: a GitHub PAT
# pasted after the word "leaked:" sailed through, because the keyword list had
# no such word — prose keywords are the wrong tool for well-known token shapes).
# These fire with NO surrounding context; each format is distinctive enough
# that false positives are practically impossible in prose.
BARE_TOKEN = re.compile(
    r"(?:"
    r"ghp_[A-Za-z0-9]{36}"                      # GitHub classic PAT
    r"|github_pat_[A-Za-z0-9_]{22,}"            # GitHub fine-grained PAT
    r"|gho_[A-Za-z0-9]{36}"                     # GitHub OAuth
    r"|glpat-[A-Za-z0-9\-_]{20,}"               # GitLab PAT
    r"|xox[bpoas]-[A-Za-z0-9\-]{10,}"           # Slack tokens
    r"|sk-ant-[A-Za-z0-9_\-]{20,}"              # Anthropic keys
    r"|sk-proj-[A-Za-z0-9_\-]{20,}"             # OpenAI project keys
    r"|AKIA[0-9A-Z]{16}"                        # AWS access key id
    r"|AIza[0-9A-Za-z\-_]{35}"                  # Google API key
    r"|syt_[A-Za-z0-9]+_[A-Za-z0-9]+_[A-Za-z0-9]+"  # Matrix/Synapse token
    r"|-----BEGIN[A-Z ]*PRIVATE KEY-----"       # PEM private keys
    r")")
# A locator only counts NEAR the match (a small window) — a "see below" half a line
# away does not excuse a value
LOCATOR = re.compile(r"1password|keychain|op://|vault|locat|stored in|lives in|password manager", re.I)
# Looks like a placeholder/description, not a secret
PLACEHOLDER = re.compile(r"^[<\[{(*•]|^(yes|no|none|never|nowhere|only|redacted|no-key|placeholder|dummy|example|sample|changeme|<?SECRET|\*{3,})", re.I)


def scan(path):
    hits = []
    try:
        text = open(path, encoding="utf-8", errors="replace").read()
    except OSError:
        return hits
    for n, line in enumerate(text.splitlines(), 1):
        if BARE_TOKEN.search(line):
            hits.append((n, "bare token format"))
            continue
        m = KEYWORD.search(line)
        if not m:
            continue
        window = line[max(0, m.start() - 60):m.end() + 90]  # path-to-script before + "(keychain)" later in the line
        if LOCATOR.search(window) or LOCATOR.search(m.group(1)):
            continue
        val = m.group(1)
        if PLACEHOLDER.match(val):
            continue
        # A "value" made purely of non-Latin letters is an ordinary prose word in a
        # non-English vault ("Token: <native word> ..."); real secrets are built from
        # Latin letters/digits/symbols (false-positive case, 2026-07-05)
        if re.fullmatch(r"(?:[^\W\da-zA-Z_]|['’])+[.,;:]?", val):
            continue
        # A PATH value (~/.netrc, /path/to/tokens) is a storage LOCATION, not a
        # secret — exactly the sanctioned "name + location" pattern
        # (false-positive case #3, 2026-07-05)
        if re.match(r"^[~/.][\w~./-]*[,)]?$", val):
            continue
        hits.append((n, line.strip()[:80]))
    return hits


def main():
    bad = 0
    for p in sys.argv[1:]:
        for n, frag in scan(p):
            bad = 1
            # never print the full fragment to standard logs — only the location
            print(f"SUSPECT (secret in prose?): {p}:{n} — review manually")
    sys.exit(bad)


if __name__ == "__main__":
    main()
