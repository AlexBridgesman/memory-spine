#!/usr/bin/env python3
"""spine-status — sanctioned status transition for existing AgentMemory records.

Usage:
  spine-status <path-or-ULID> --status blocked --agent claude-code --reason "why"

Edits only:
  - frontmatter `status:` line
  - appends one line to `## Status history`

Does not commit/push; run spine-sync after validation.
"""
import argparse
import datetime
import os
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(os.path.expanduser(os.environ.get("SPINE_ROOT", "~/AgentMemory"))).resolve()
TOOLS = os.environ.get("SPINE_TOOLS_DIR") or os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
def _config_dir():
    """Same resolution order as spine-gen (keep in sync)."""
    env = os.environ.get("SPINE_CONFIG_DIR")
    if env:
        return Path(os.path.expanduser(env))
    tools = Path(TOOLS)
    vault = Path(os.path.expanduser(os.environ.get("SPINE_ROOT", "~/AgentMemory")))
    for c in (tools / "config", vault / "config"):
        if (c / "projects.txt").is_file():
            return c
    return tools / "config"


CFG = _config_dir()
VALID_STATUS = ["active", "blocked", "resolved", "superseded", "archived"]


def _load_list(name):
    path = CFG / name
    try:
        items = [l.strip() for l in path.read_text().splitlines()
                 if l.strip() and not l.lstrip().startswith("#")]
    except OSError:
        sys.exit(f"spine-status: dictionary missing: {path}")
    if not items:
        sys.exit(f"spine-status: dictionary empty: {path}")
    return items


VALID_AGENTS = _load_list("agents.txt")
PROJECTS = set(_load_list("projects.txt"))
TYPEDIRS = {"decisions", "facts", "threads", "artifacts"}
ULID_RE = re.compile(r"[0-9A-HJKMNP-TV-Z]{26}")


def die(msg: str, code: int = 1):
    sys.stderr.write(f"spine-status: ERROR: {msg}\n")
    sys.exit(code)


def is_record_path(path: Path) -> bool:
    try:
        rel = path.resolve().relative_to(ROOT)
    except ValueError:
        return False
    parts = rel.parts
    return len(parts) == 3 and parts[0] in PROJECTS and parts[1] in TYPEDIRS and parts[2].endswith(".md")


def find_by_ulid(value: str) -> Path:
    matches = list(ROOT.glob(f"*/*/*{value}*.md"))
    matches = [p for p in matches if is_record_path(p)]
    if not matches:
        die(f"ULID not found: {value}")
    if len(matches) > 1:
        die("ULID is not unique: " + ", ".join(str(p) for p in matches))
    return matches[0]


def resolve_target(target: str) -> Path:
    if ULID_RE.fullmatch(target):
        return find_by_ulid(target)
    p = Path(os.path.expanduser(target))
    if not p.is_absolute():
        p = (Path.cwd() / p).resolve()
    if not p.exists():
        die(f"file does not exist: {p}")
    if not is_record_path(p):
        die(f"not an AgentMemory record path: {p}")
    return p


def parse_current_status(text: str) -> str:
    if not text.startswith("---\n"):
        die("no frontmatter")
    end = text.find("\n---", 4)
    if end < 0:
        die("frontmatter not closed")
    fm = text[4:end]
    m = re.search(r"^status:\s*(\S+)\s*$", fm, re.M)
    if not m:
        die("frontmatter has no status:")
    return m.group(1)


def append_status_history(text: str, line: str) -> str:
    marker = "\n## Status history\n"
    if marker in text:
        return text.rstrip() + "\n" + line + "\n"
    rel_marker = "\n## Relations\n"
    if rel_marker in text:
        before, after = text.split(rel_marker, 1)
        return before.rstrip() + "\n\n## Status history\n" + line + "\n" + rel_marker + after
    return text.rstrip() + "\n\n## Status history\n" + line + "\n"


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("target", help="AgentMemory record path or ULID")
    # default identity for unattended callers (a private deployment may default
    # this to its always-on maintenance agent profile instead)
    ap.add_argument("--agent", default=os.environ.get("SPINE_AGENT", "shared"), choices=VALID_AGENTS)
    ap.add_argument("--status", required=True, choices=VALID_STATUS)
    ap.add_argument("--reason", required=True, help="short human-readable reason; no secrets")
    ap.add_argument("--dry-run", action="store_true")
    a = ap.parse_args()

    path = resolve_target(a.target)
    text = path.read_text(encoding="utf-8", errors="replace")
    current = parse_current_status(text)
    if current not in VALID_STATUS:
        die(f"current status is invalid: {current}")
    if current == a.status:
        print(f"NOOP: {path} already status={a.status}")
        return

    now = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    clean_reason = a.reason.replace("\n", " ").strip()
    if not clean_reason:
        die("--reason is empty")

    new_text = re.sub(r"^status:\s*\S+\s*$", f"status: {a.status}", text, count=1, flags=re.M)
    history_line = f"- {now} — {a.agent}: {current} -> {a.status}. Reason: {clean_reason}"
    new_text = append_status_history(new_text, history_line)

    if a.dry_run:
        print(f"DRY-RUN: {path}: {current} -> {a.status}")
        print(history_line)
        return

    path.write_text(new_text, encoding="utf-8")
    validator = Path(os.path.dirname(os.path.abspath(__file__))) / "spine-validate"
    r = subprocess.run([str(validator), str(path)], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    print(r.stdout, end="")
    if r.returncode != 0:
        die(f"validation failed after the status transition; file left in place for manual review: {path}", code=2)
    print(f"UPDATED: {path}: {current} -> {a.status}")


if __name__ == "__main__":
    main()
