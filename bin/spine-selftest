#!/bin/bash
# spine-selftest — weekly memory CI (v3.3): verifies the defense layers by fact,
# not by faith. The default entrypoint creates a minimal scratch vault and runs
# all write-mechanics probes there. Only T9/T10 inspect the installed vault and
# tools, and both checks are read-only.
# v3.3 review: negative tests require a SPECIFIC exit code (1/2), not any
# nonzero — otherwise a broken tool (127) produced a false PASS.
set -u
# The self-test exercises WRITE MECHANICS on arbitrary machines — including CI
# runners whose process chains are rightly NOT in anyone's allowlist (caught on
# 2026-07-30: the gate denied the runner and three tests failed for the wrong
# reason, while refusal-shaped tests had been "passing" via gate denials).
# SPINE_NO_GATE is the sanctioned escape; the gate's refusal behavior is out
# of scope for this write-mechanics test and must be tested separately.
export SPINE_NO_GATE=1
BIN="$(cd "$(dirname "$0")" && pwd)"
TOOLS="${SPINE_TOOLS_DIR:-$(dirname "$BIN")}"
ROOT="${SPINE_ROOT:-$HOME/AgentMemory}"
. "$TOOLS/lib/spine_paths.sh"
REMOTE_ROOT="${SPINE_REMOTE_ROOT:-$(spine_default_remote_root)}"
BARE="${SPINE_AGENT_BARE:-$REMOTE_ROOT/AgentMemory.git}"
PY="${SPINE_PYTHON:-$(command -v python3 || echo /usr/bin/python3)}"
GITLEAKS="${SPINE_GITLEAKS:-$(command -v gitleaks || echo /opt/homebrew/bin/gitleaks)}"
GIT="${SPINE_GIT:-}"
if [ -z "$GIT" ]; then
  GIT=$(command -v git 2>/dev/null || true)
  [ -n "$GIT" ] || for c in /opt/homebrew/bin/git /usr/local/bin/git /usr/bin/git; do
    [ -x "$c" ] && { GIT="$c"; break; }
  done
fi

# Never exercise write probes against the installed vault. Build a tiny
# synthetic vault from the installed dictionaries, then invoke this script once
# in inner mode. The live vault, mirror, and canonical hook are passed only to
# the read-only T9/T10 checks below.
if [ "${SPINE_SELFTEST_INNER:-0}" != "1" ]; then
  SCRATCH=$(mktemp -d "${TMPDIR:-/tmp}/spine-selftest-isolated.XXXXXX") || exit 1
  cleanup_outer() { rm -rf "$SCRATCH"; }
  trap cleanup_outer EXIT INT TERM HUP
  SCRATCH_HOME="$SCRATCH/home"
  SCRATCH_TOOLS="$SCRATCH_HOME/dev/memory-spine"
  SCRATCH_ROOT="$SCRATCH_HOME/AgentMemory"
  SCRATCH_LOG="$SCRATCH_HOME/.local/state/AgentMemory"
  mkdir -p "$SCRATCH_HOME/dev" "$SCRATCH_ROOT/_index" "$SCRATCH_ROOT/config" "$SCRATCH_LOG"
  cp -R "$TOOLS" "$SCRATCH_TOOLS"

  LIVE_CFG="${SPINE_CONFIG_DIR:-}"
  if [ -z "$LIVE_CFG" ]; then
    for c in "$TOOLS/config" "$ROOT/config"; do
      [ -f "$c/projects.txt" ] && { LIVE_CFG="$c"; break; }
    done
  fi
  : "${LIVE_CFG:=$TOOLS/config}"
  cp "$LIVE_CFG/projects.txt" "$SCRATCH_TOOLS/config/projects.txt"
  cp "$LIVE_CFG/agents.txt" "$SCRATCH_TOOLS/config/agents.txt"
  cp "$ROOT/.gitleaks.toml" "$SCRATCH_ROOT/.gitleaks.toml"

  while IFS= read -r project; do
    case "$project" in ''|'#'*) continue ;; esac
    mkdir -p "$SCRATCH_ROOT/$project"/{decisions,facts,threads,artifacts}
    printf '# %s\n' "$project" > "$SCRATCH_ROOT/$project/$project.md"
  done < "$SCRATCH_TOOLS/config/projects.txt"

  "$GIT" -C "$SCRATCH_ROOT" init -q -b main
  "$GIT" -C "$SCRATCH_ROOT" config user.name "Memory Spine Selftest"
  "$GIT" -C "$SCRATCH_ROOT" config user.email "selftest@example.invalid"
  "$GIT" -C "$SCRATCH_ROOT" add .
  "$GIT" -C "$SCRATCH_ROOT" commit -qm "selftest fixture"

  SPINE_SELFTEST_INNER=1 \
  HOME="$SCRATCH_HOME" \
  SPINE_ROOT="$SCRATCH_ROOT" \
  SPINE_TOOLS_DIR="$SCRATCH_TOOLS" \
  SPINE_CONFIG_DIR="$SCRATCH_TOOLS/config" \
  SPINE_LOG_DIR="$SCRATCH_LOG" \
  SPINE_SELFTEST_LIVE_ROOT="$ROOT" \
  SPINE_SELFTEST_LIVE_TOOLS="$TOOLS" \
  SPINE_SELFTEST_LIVE_BARE="$BARE" \
  SPINE_GITLEAKS="$GITLEAKS" \
  SPINE_GIT="$GIT" \
    "$SCRATCH_TOOLS/bin/spine-selftest"
  RC=$?
  cleanup_outer
  trap - EXIT INT TERM HUP
  exit "$RC"
fi

# Config dir resolution — must match spine-gen/spine-validate: env override,
# then the tools config, then the vault config.
CFG_DIR="${SPINE_CONFIG_DIR:-}"
if [ -z "$CFG_DIR" ]; then
  for c in "$TOOLS/config" "$ROOT/config"; do
    [ -f "$c/projects.txt" ] && { CFG_DIR="$c"; break; }
  done
fi
: "${CFG_DIR:=$TOOLS/config}"
DICT="$CFG_DIR/projects.txt"
# First non-inbox scope from the dictionary hosts the inert transients
FIRST_SCOPE=$(grep -v '^#' "$DICT" 2>/dev/null | grep -v '^inbox$' | grep . | head -1)
: "${FIRST_SCOPE:=inbox}"
AGENT_DICT="$CFG_DIR/agents.txt"
TEST_AGENT=$(grep -v '^#' "$AGENT_DICT" 2>/dev/null | grep . | head -1)
: "${TEST_AGENT:=user}"

TMPD=$(mktemp -d "${TMPDIR:-/tmp}/spine-selftest.XXXXXX")
VAULT_TMP="$ROOT/$FIRST_SCOPE/facts/selftest-dup-key-transient.md"
VALID_TMP="$ROOT/$FIRST_SCOPE/facts/selftest-valid-transient.md"
PASS=0; FAIL=0
cleanup() { rm -rf "$TMPD"; rm -f "$VAULT_TMP" "$VALID_TMP"; }
trap cleanup EXIT INT TERM HUP

ok()   { PASS=$((PASS+1)); echo "PASS: $1"; }
bad()  { FAIL=$((FAIL+1)); echo "FAIL: $1"; }
expect_refusal() { # $1=description; then the command. We expect EXACTLY exit 1 or 2 (a deliberate refusal).
  local desc="$1"; shift
  "$@" >/dev/null 2>&1
  local rc=$?
  case "$rc" in
    1|2) ok "$desc";;
    0)   bad "$desc (passed, but should have refused)";;
    *)   bad "$desc (rc=$rc — tool broken, not a refusal)";;
  esac
}

# T0: tool pre-check — without it the negative tests below would lie
PRE_OK=1
for t in "$GITLEAKS" "$PY" "$GIT" "$BIN/spine-new" "$BIN/spine-validate" "$BIN/spine-gen" "$BIN/spine-packet" "$BIN/spine-promote"; do
  [ -x "$t" ] || { bad "T0 tool missing/not executable: $t"; PRE_OK=0; }
done
[ -f "$ROOT/.gitleaks.toml" ] || { bad "T0 missing $ROOT/.gitleaks.toml"; PRE_OK=0; }
[ "$PRE_OK" = 1 ] && ok "T0 all tools in place"

# T0b: positive smoke — validate must return 0 on a REAL valid record; on a fresh
# vault with no records yet, an inert synthetic record (private+archived) stands in
mkdir -p "$ROOT/$FIRST_SCOPE/facts"
SAMPLE=""
while IFS= read -r p; do
  f=$(find "$ROOT/$p/facts" -name "*.md" 2>/dev/null | head -1)
  [ -n "$f" ] && { SAMPLE="$f"; break; }
done < <(grep -v '^#' "$DICT" 2>/dev/null | grep .)
if [ -z "$SAMPLE" ]; then
  printf -- "---\ntype: fact\nproject: %s\nagent: %s\ntitle: \"selftest valid\"\nstatus: archived\ncreated: 2026-01-01T00:00:00Z\nsources:\n  - session:selftest\nsensitivity: private\nconfidence: candidate\n---\nx [[%s]]\n" "$FIRST_SCOPE" "$TEST_AGENT" "$FIRST_SCOPE" > "$VALID_TMP"
  SAMPLE="$VALID_TMP"
fi
if "$PY" "$BIN/spine-validate" "$SAMPLE" 2>/dev/null | grep -q "^OK:"; then
  ok "T0b validate positive smoke"
else
  bad "T0b validate does not pass on a valid record: $SAMPLE"
fi
rm -f "$VALID_TMP"

# T1: unknown project → refusal (exit 1)
expect_refusal "T1 spine-new refuses an unknown project" \
  "$PY" "$BIN/spine-new" --type fact --project no-such-project --title x --agent "$TEST_AGENT"

# T2: inbox without proposed-scope → refusal
expect_refusal "T2 spine-new requires --proposed-scope for inbox" \
  "$PY" "$BIN/spine-new" --type fact --project inbox --title x --agent "$TEST_AGENT"

# T3: frontmatter injection (newline in a field) → refusal
expect_refusal "T3 spine-new blocks \\n injection in summary" \
  "$PY" "$BIN/spine-new" --type fact --project inbox --proposed-scope t --title x \
    --agent "$TEST_AGENT" --summary "$(printf 'a\nconfidence: verified')"

# T4: a fake secret is caught by the per-file scan WITH the vault config; strict rc=1.
# The token is assembled at RUNTIME (printf %s): a literal in this file would trip
# the tools repo's own staged scan — our own gitleaks caught exactly that during a
# v3.3 commit :)
printf -- "token sk-ant-oat01-%s\n" "SELFTESTFAKEFAKEFAKEFAKE123456" > "$TMPD/fake.md"
"$GITLEAKS" dir "$TMPD/fake.md" --config "$ROOT/.gitleaks.toml" --no-banner --redact --exit-code 1 >/dev/null 2>&1
RC=$?
case "$RC" in
  1) ok "T4 gitleaks per-file catches custom rules";;
  0) bad "T4 gitleaks did NOT catch the fake sk-ant-oat01";;
  *) bad "T4 gitleaks broken (rc=$RC)";;
esac

# T5: validate catches duplicated keys. The transient is INERT: private+archived —
# even stuck after a SIGKILL it never reaches the packet/INDEX/inbox counter
printf -- "---\ntype: fact\nproject: %s\nagent: %s\ntitle: \"selftest\"\nstatus: archived\ncreated: 2026-01-01T00:00:00Z\nsources:\n  - session:selftest\nsensitivity: private\nconfidence: candidate\nconfidence: verified\n---\nx [[%s]]\n" "$FIRST_SCOPE" "$TEST_AGENT" "$FIRST_SCOPE" > "$VAULT_TMP"
expect_refusal "T5 spine-validate catches duplicated frontmatter key" \
  "$PY" "$BIN/spine-validate" "$VAULT_TMP"
rm -f "$VAULT_TMP"

# T6: spine-gen clean AND without WARN (a journal failure used to hide behind exit 0 — v3.3 review)
GENOUT=$("$PY" "$BIN/spine-gen" 2>&1)
if [ $? -eq 0 ] && ! echo "$GENOUT" | grep -q "WARN"; then
  ok "T6 spine-gen without failures or WARN"
else
  bad "T6 spine-gen: $(echo "$GENOUT" | grep WARN | head -2)"
fi

# T7: a packet exists for EVERY scope in the dictionary
MISS=""
while IFS= read -r p; do
  [ -f "$ROOT/_index/packet-$p.md" ] || MISS="$MISS $p"
done < <(grep -v '^#' "$DICT" | grep .)
if [ -z "$MISS" ]; then ok "T7 all packets in place"; else bad "T7 missing packets:$MISS"; fi

# T8: cwd resolution = whatever the map says for $HOME (no hardcode — v3.3 review).
# Without a cwd-map entry for $HOME, test the inverse contract instead: an
# unmapped directory must resolve to no scope at all.
MAP="$CFG_DIR/cwd-map.tsv"
[ -f "$MAP" ] || MAP="$TOOLS/config/cwd-map.tsv"
EXPECTED=""
[ -f "$MAP" ] && EXPECTED=$(grep -v '^#' "$MAP" | awk -F'\t' -v h="$HOME" '$1 == h {print $2}' | head -1)
if [ -n "$EXPECTED" ]; then
  R=$("$BIN/spine-packet" --cwd "$HOME" --resolve 2>/dev/null)
  if [ "$R" = "$EXPECTED" ]; then
    ok "T8 packet resolution ($R)"
  else
    bad "T8 resolution returned '$R', the map says '$EXPECTED'"
  fi
else
  R=$("$BIN/spine-packet" --cwd "$TMPD" --resolve 2>/dev/null)
  if [ -z "$R" ]; then
    ok "T8 packet resolution (no map entry for \$HOME; unmapped dir yields no scope)"
  else
    bad "T8 unmapped dir resolved to '$R' (expected nothing)"
  fi
fi

# T9: installed local == bare; this check is read-only. An ABSENT bare = FAIL
# (v3.3 review: an empty bare HEAD used to produce a false PASS).
LIVE_ROOT="${SPINE_SELFTEST_LIVE_ROOT:-$ROOT}"
LIVE_BARE="${SPINE_SELFTEST_LIVE_BARE:-$BARE}"
if [ ! -d "$LIVE_BARE" ]; then
  bad "T9 bare mirror ABSENT: $LIVE_BARE"
else
  LH=$("$GIT" -C "$LIVE_ROOT" rev-parse HEAD 2>/dev/null)
  BH=$("$GIT" -C "$LIVE_BARE" rev-parse HEAD 2>/dev/null)
  if [ -z "$LH" ] || [ -z "$BH" ]; then
    bad "T9 HEAD unreadable (local='$LH' bare='$BH')"
  elif [ "$LH" = "$BH" ]; then
    ok "T9 local==bare"
  else
    AHEAD=$("$GIT" -C "$ROOT" rev-list --count "$BH..$LH" 2>/dev/null || echo x)
    BEHIND=$("$GIT" -C "$ROOT" rev-list --count "$LH..$BH" 2>/dev/null || echo x)
    if [ "$BEHIND" = "0" ] && [ "$AHEAD" != "x" ] && [ "$AHEAD" != "0" ]; then
      ok "T9 local ahead of bare by $AHEAD (sync will catch up)"
    else
      bad "T9 local != bare (ahead=$AHEAD behind=$BEHIND)"
    fi
  fi
fi

# T10: the installed hook matches the installed canonical copy (read-only)
LIVE_TOOLS="${SPINE_SELFTEST_LIVE_TOOLS:-$TOOLS}"
if cmp -s "$LIVE_TOOLS/hooks/pre-commit" "$LIVE_ROOT/.git/hooks/pre-commit"; then
  ok "T10 pre-commit hook = canon"
else
  bad "T10 pre-commit hook missing/diverged from canon"
fi

# T11: leftovers of previous selftests in the vault (a transient stuck after SIGKILL)
LEFT=$(find "$ROOT" -name "selftest-*transient*" 2>/dev/null | grep -v "$VAULT_TMP" | grep -v "$VALID_TMP" | head -3)
if [ -z "$LEFT" ]; then ok "T11 no leftover transient files"; else bad "T11 leftovers: $LEFT"; fi

# T12: spine-new refuses a record whose body carries a secret VALUE (inline
# scan before the vault — external review 2026-07-30: the README promised it,
# the code did not deliver; a secret used to sit in plaintext until commit time)
# The fixture token is assembled at runtime: a literal full-shape token in this
# file would itself trip gitleaks on the repo (it did — caught by the release
# lint on 2026-07-30). The prefix and tail never appear contiguously on disk.
T12_TOK="ghp_"
T12_TOK="${T12_TOK}0123456789abcdefghij0123456789abcdef"
OUT12=$("$PY" "$BIN/spine-new" --type fact --project "$FIRST_SCOPE" --agent "$TEST_AGENT" \
  --title "selftest secret refusal transient" \
  --body "leaked: $T12_TOK" 2>&1)
if [ $? -ne 0 ] && echo "$OUT12" | grep -q "SECRET VALUE"; then
  ok "T12 spine-new refuses a secret value inline"
else
  bad "T12 secret value was NOT refused: $(echo "$OUT12" | head -1)"
  find "$ROOT/$FIRST_SCOPE" -name "*selftest-secret-refusal*" -delete 2>/dev/null
fi

# T13: the dedup gate refuses a near-duplicate title and points to the original;
# --allow-duplicate is the conscious escape (same review)
T13_TITLE="selftest dedup gate transient probe"
# the base twin is a plain record: archived/private flags are (correctly)
# rejected at creation time, which silently voided the first version of this test
F13=$("$PY" "$BIN/spine-new" --type fact --project "$FIRST_SCOPE" --agent "$TEST_AGENT" \
  --title "$T13_TITLE" --body "twin base. [[$FIRST_SCOPE]]" 2>/dev/null | tail -1)
[ -f "$F13" ] || bad "T13 setup: base twin was not created"
OUT13=$("$PY" "$BIN/spine-new" --type fact --project "$FIRST_SCOPE" --agent "$TEST_AGENT" \
  --title "$T13_TITLE" --body "twin attempt" 2>&1)
if [ $? -ne 0 ] && echo "$OUT13" | grep -q "probable duplicate"; then
  ok "T13 dedup gate refuses a near-duplicate title"
else
  bad "T13 near-duplicate was NOT refused: $(echo "$OUT13" | head -1)"
fi
rm -f "$F13" 2>/dev/null
find "$ROOT/$FIRST_SCOPE" -name "*selftest-dedup-gate-transient*" -delete 2>/dev/null

# T14: a superseded record disappears from the packet (current view) while its
# replacement stays (same review: "immutability piles up stale records")
U14=$("$PY" "$BIN/spine-new" --type fact --project "$FIRST_SCOPE" --agent "$TEST_AGENT" \
  --title "selftest supersede old transient fact" --confidence verified \
  --body "old knowledge. [[$FIRST_SCOPE]]" 2>/dev/null | tail -1)
UID14=$(basename "$U14" | grep -oE "[0-9A-HJKMNP-TV-Z]{26}")
N14=$("$PY" "$BIN/spine-new" --type fact --project "$FIRST_SCOPE" --agent "$TEST_AGENT" \
  --title "selftest supersede new transient fact" --confidence verified \
  --supersedes "$UID14" --body "new knowledge. [[$FIRST_SCOPE]]" 2>/dev/null | tail -1)
"$PY" "$BIN/spine-gen" >/dev/null 2>&1
PK14="$ROOT/_index/packet-$FIRST_SCOPE.md"
if grep -q "supersede new transient" "$PK14" 2>/dev/null && \
   ! grep -q "supersede old transient" "$PK14" 2>/dev/null; then
  ok "T14 superseded record hidden from the packet, replacement shipped"
else
  bad "T14 packet still ships the superseded record (or lost the replacement)"
fi
rm -f "$U14" "$N14" 2>/dev/null
"$PY" "$BIN/spine-gen" >/dev/null 2>&1   # regenerate without the transients

# T15: a MISSING secret scanner is fail-closed (review round 2: the first
# version wrote unscanned with just a warning); SPINE_NO_SCAN=1 is the audited
# escape. The scanner is hidden for one call only.
mv "$BIN/spine-secrets-lint" "$BIN/spine-secrets-lint.hidden"
OUT15=$("$PY" "$BIN/spine-new" --type fact --project "$FIRST_SCOPE" --agent "$TEST_AGENT" \
  --title "selftest noscan refusal transient" --body "plain body" 2>&1)
RC15=$?
F15=$(SPINE_NO_SCAN=1 "$PY" "$BIN/spine-new" --type fact --project "$FIRST_SCOPE" --agent "$TEST_AGENT" \
  --title "selftest noscan escape transient" --body "plain body" 2>/dev/null | tail -1)
mv "$BIN/spine-secrets-lint.hidden" "$BIN/spine-secrets-lint"
if [ "$RC15" -ne 0 ] && echo "$OUT15" | grep -q "fail-closed" && [ -f "$F15" ]; then
  ok "T15 missing scanner refuses; SPINE_NO_SCAN=1 escape writes"
else
  bad "T15 missing-scanner behavior wrong (rc=$RC15, escape file: ${F15:-none})"
fi
rm -f "$F15" 2>/dev/null
find "$ROOT/$FIRST_SCOPE" -name "*selftest-noscan*" -delete 2>/dev/null

# T16: spine-promote — a confidence NOOP does NOT swallow --reviewed-by-owner
# (caught live 2026-07-30 on verified->verified: the early return exited before
# the reviewed_by insertion branch, the flag was lost silently). Live: dry-run
# shows the intent and does NOT write; the real call sets reviewed_by/reviewed_at
# plus an honest trail line in Status history; a repeat is a full NOOP
# ("reviewed_by already set").
F16=$("$PY" "$BIN/spine-new" --type fact --project "$FIRST_SCOPE" --agent "$TEST_AGENT" \
  --title "selftest promote reviewed transient" --confidence verified \
  --body "review me. [[$FIRST_SCOPE]]" 2>/dev/null | tail -1)
[ -f "$F16" ] || bad "T16 setup: transient was not created"
DR16=$("$PY" "$BIN/spine-promote" "$F16" --confidence verified --agent "$TEST_AGENT" \
  --reviewed-by-owner --reason "selftest T16 dry" --dry-run 2>&1)
DRYW16=$(grep -c "^reviewed_by:" "$F16" 2>/dev/null)   # must still be 0 after dry-run
OUT16=$("$PY" "$BIN/spine-promote" "$F16" --confidence verified --agent "$TEST_AGENT" \
  --reviewed-by-owner --reason "selftest T16" 2>&1)
NOOP16=$("$PY" "$BIN/spine-promote" "$F16" --confidence verified --agent "$TEST_AGENT" \
  --reviewed-by-owner --reason "selftest T16 repeat" 2>&1)
if echo "$DR16" | grep -qF "confidence unchanged (verified), +reviewed_by: owner" \
   && [ "${DRYW16:-x}" = "0" ] \
   && echo "$OUT16" | grep -qF "confidence unchanged (verified), +reviewed_by: owner" \
   && grep -q "^reviewed_by: owner$" "$F16" 2>/dev/null \
   && grep -q "^reviewed_at: " "$F16" 2>/dev/null \
   && grep -qF "reviewed_by: owner (confidence verified unchanged). Reason: selftest T16" "$F16" 2>/dev/null \
   && echo "$NOOP16" | grep -qF "reviewed_by already set"; then
  ok "T16 promote: a confidence NOOP does not lose reviewed_by"
else
  bad "T16 promote loses/misreports reviewed_by (dry:$(echo "$DR16"|head -1) run:$(echo "$OUT16"|tail -1) rep:$(echo "$NOOP16"|head -1))"
fi
rm -f "$F16" 2>/dev/null
find "$ROOT/$FIRST_SCOPE" -name "*selftest-promote-reviewed*" -delete 2>/dev/null

echo "selftest: PASS $PASS / FAIL $FAIL"
[ "$FAIL" -eq 0 ]
